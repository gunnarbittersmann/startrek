RewriteEngine on
ErrorDocument 503 /startrek/maintenance.html
RewriteCond %{REQUEST_URI} !^/startrek/maintenance
RewriteCond %{REQUEST_URI} !\.css$
RewriteCond %{REQUEST_URI} !\.ico$
RewriteRule .* - [L,R=503]

<FilesMatch "\.jsonld$">
	<IfModule mod_headers.c>
		Header set Access-Control-Allow-Origin "*"
	</IfModule>
</FilesMatch>
